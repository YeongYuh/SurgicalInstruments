# Environment variable reference for the Surgical Instrument Counting System.
# Copy this file to .env and adjust values, or export variables before running.
#
# run_jetson.sh already sets SCALE_READER_MODE, SERIAL_PORT, and SERIAL_BAUDRATE
# to the defaults below — you only need to set them if you want different values.
#
# Usage:
#   export $(grep -v '^#' .env | xargs)
#   ./run_jetson.sh

# ── Web server ────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# ── Model package ─────────────────────────────────────────────────────────────
# Which surgical instrument family the platform runs.  The manifest at
# model_packages/<id>/manifest.json is the source of truth for the adapter, the
# model file, the per-class weights, and the factory-default standards.
ACTIVE_MODEL_PACKAGE=demo
MODEL_PACKAGES_DIR=model_packages
# Named tray forced on every process start, before the first inference.  Without
# it the package restores whichever preset was active at the last shutdown, so
# the unit would begin wherever the previous operator left it.  Leave EMPTY to
# keep that restored preset instead.  Must name a preset of the active package —
# SurgeryB belongs to `demo`, so change both together.
STARTUP_INVENTORY_PRESET=SurgeryB
# Operator-edited, per-package standards / unit weights live here.
PROFILES_DIR=output/profiles
# Package that inherits the pre-package global output/standards.json on first start.
LEGACY_PACKAGE_ID=ortho_tka

# Overrides the manifest's inference.confidence.  Leave unset to use the package value.
CONF_THRESHOLD=0.25

# ── Legacy model settings (app/main.py CLI only) ─────────────────────────────
# The web platform IGNORES these — the active package manifest decides the
# adapter, the model file, and the task.  They remain for the standalone CLI.
MODEL_PATH=models/best.pt
DETECTOR_BACKEND=onnx
ONNX_MODEL_PATH=models/best.onnx
ONNX_TASK=segment
STRICT_DETECTOR_BACKEND=false

# ── Scale / serial  (verified working on Jetson Nano) ─────────────────────────
# Set SCALE_READER_MODE=mock if no physical scale is connected.
SCALE_READER_MODE=serial

# Common Jetson Nano paths:
#   USB scale / CH340 adapter : /dev/ttyUSB0
#   Arduino Uno / Leonardo    : /dev/ttyACM0
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600

# How long to wait for a single serial line (seconds).
# Lower values make read_weight() return faster when the buffer is empty.
SERIAL_TIMEOUT=2.0

# Maximum lines to drain per read_weight() call.
SERIAL_READ_RETRIES=5

# ── Scale stability gate ──────────────────────────────────────────────────────
# A PASS/FAIL verdict is issued only for a reading that is both fresh and
# settled.  Until then the UI shows 量測中 — an unsettled scale is an unfinished
# measurement, not a failed inventory.
# Time window the readings must stay within range for.
# 2.5 s, sized for the ~2.2 Hz this unit's scale actually emits: a 1.5 s window
# left exactly the 3-sample minimum with no margin.
SCALE_STABLE_WINDOW_SEC=2.5
# Maximum max-min spread inside that window, in grams.
SCALE_STABLE_RANGE_GRAMS=1.0
# Minimum number of samples inside the window.
SCALE_STABLE_MIN_SAMPLES=3
# Beyond this age the cached reading is reported fresh=false, so a value cached
# before the cable was pulled can never be verified as if it were live.
SCALE_MAX_SAMPLE_AGE_SEC=2.0
# Fraction of the window that must actually be covered by samples (0-1).
SCALE_STABLE_MIN_COVERAGE_RATIO=0.5

# ── Camera ────────────────────────────────────────────────────────────────────
# USB webcam on /dev/video0 → index 0.
# Jetson CSI camera requires a GStreamer pipeline string instead of an integer.
WEBCAM_INDEX=0
WEBCAM_WIDTH=640
WEBCAM_HEIGHT=480
WEBCAM_FPS=15

# CAMERA_FOURCC: YUYV (default, stable on Jetson) | MJPG | AUTO
# YUYV: raw planar YUV from the driver — no libjpeg decode warnings, stable preview.
# MJPG: camera sends native MJPEG — faster in theory but causes "Corrupt JPEG data"
#       warnings on some Jetson/USB camera combinations (frames are still valid).
# Measured FPS is ~7.5 on this camera regardless of which fourcc is used.
CAMERA_FOURCC=YUYV

# Seconds between YOLO inferences in webcam / continuous mode.
# Live preview updates independently at ~7-15 FPS regardless of this value.
WEBCAM_DETECTION_INTERVAL=5.0

# ── Camera runtime recovery ───────────────────────────────────────────────────
# A USB camera can stop delivering frames while the device node stays open.
# After this many consecutive failed reads the capture is released and reopened
# with a bounded exponential backoff (cancelled immediately by /camera/stop).
CAMERA_READ_FAIL_THRESHOLD=60
CAMERA_REOPEN_BACKOFF_SEC=1.0
CAMERA_REOPEN_MAX_BACKOFF_SEC=15.0

# ── Paths ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
INPUT_PATH=input/test_image.jpg

# ── Weight verification ───────────────────────────────────────────────────────
EXPECTED_WEIGHT=1520.35
WEIGHT_TOLERANCE=0.5

# Mock weight returned when SCALE_READER_MODE=mock
MOCK_WEIGHT=1520.35

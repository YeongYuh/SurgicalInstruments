# Environment variable reference for the Surgical Instrument Counting System.
# Copy this file to .env and adjust values, or export variables before running.
#
# run_jetson.sh already sets SCALE_READER_MODE, SERIAL_PORT, and SERIAL_BAUDRATE
# to the defaults below — you only need to set them if you want different values.
#
# Usage:
#   export $(grep -v '^#' .env | xargs)
#   ./run_jetson.sh

# ── Web server ────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# ── YOLO model ────────────────────────────────────────────────────────────────
MODEL_PATH=models/best.pt
CONF_THRESHOLD=0.25

# ── Detector backend ─────────────────────────────────────────────────────────
# onnx  : ONNX Runtime CPUExecutionProvider (~1.6 s/frame on Jetson Nano — default)
# pt    : PyTorch/Ultralytics              (~6.3 s/frame on Jetson Nano)
# If best.onnx is missing, the app falls back to best.pt automatically.
# Generate best.onnx: python3 -c "from ultralytics import YOLO; YOLO('models/best.pt').export(format='onnx', opset=12)"
# Set STRICT_DETECTOR_BACKEND=true to crash instead of falling back silently.
DETECTOR_BACKEND=onnx
ONNX_MODEL_PATH=models/best.onnx
ONNX_TASK=segment
STRICT_DETECTOR_BACKEND=false

# ── Scale / serial  (verified working on Jetson Nano) ─────────────────────────
# Set SCALE_READER_MODE=mock if no physical scale is connected.
SCALE_READER_MODE=serial

# Common Jetson Nano paths:
#   USB scale / CH340 adapter : /dev/ttyUSB0
#   Arduino Uno / Leonardo    : /dev/ttyACM0
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600

# How long to wait for a single serial line (seconds).
# Lower values make read_weight() return faster when the buffer is empty.
SERIAL_TIMEOUT=2.0

# Maximum lines to drain per read_weight() call.
SERIAL_READ_RETRIES=5

# ── Camera ────────────────────────────────────────────────────────────────────
# USB webcam on /dev/video0 → index 0.
# Jetson CSI camera requires a GStreamer pipeline string instead of an integer.
WEBCAM_INDEX=0
WEBCAM_WIDTH=640
WEBCAM_HEIGHT=480
WEBCAM_FPS=15

# CAMERA_FOURCC: YUYV (default, stable on Jetson) | MJPG | AUTO
# YUYV: raw planar YUV from the driver — no libjpeg decode warnings, stable preview.
# MJPG: camera sends native MJPEG — faster in theory but causes "Corrupt JPEG data"
#       warnings on some Jetson/USB camera combinations (frames are still valid).
# Measured FPS is ~7.5 on this camera regardless of which fourcc is used.
CAMERA_FOURCC=YUYV

# Seconds between YOLO inferences in webcam / continuous mode.
# Live preview updates independently at ~7-15 FPS regardless of this value.
WEBCAM_DETECTION_INTERVAL=5.0

# ── Paths ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
INPUT_PATH=input/test_image.jpg

# ── Weight verification ───────────────────────────────────────────────────────
EXPECTED_WEIGHT=1520.35
WEIGHT_TOLERANCE=0.5

# Mock weight returned when SCALE_READER_MODE=mock
MOCK_WEIGHT=1520.35

# Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Environment (keep .env.example, ignore actual .env)
.env

# ML models — large binaries, place manually.
# Patterned on any depth: a package's model usually lives in models/<id>/,
# and `models/*.onnx` would not match it, so dropping a 40 MB binary into
# models/demo/ used to stage it for commit by accident.
models/**/*.pt
models/**/*.pth
models/**/*.engine
models/**/*.onnx
models/**/*.tflite
models/**/*.torchscript
models/*.pt
models/*.pth
models/*.engine
models/*.onnx
models/*.tflite
models/*.torchscript

# Input images — place manually
input/

# Generated output
output/uploads/
output/annotated/
output/frames/
output/history.json
# Per-package operator configuration — seeded from the package defaults on first
# start, then edited on site.  Machine-specific, so not tracked.
output/profiles/

# Logs
*.log

# Claude internal
.claude/

# OS
.DS_Store
Thumbs.db

#tmp
tmp/
